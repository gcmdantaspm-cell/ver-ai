rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Core Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
        return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\\\-]+$'); 
    }
    
    function isValidEdital(data) {
        return data.keys().hasAll(['userId', 'titulo', 'areas'])
            && data.keys().size() <= 7
            && data.userId is string
            && data.userId == request.auth.uid
            && data.titulo is string
            && data.titulo.size() <= 200
            && data.areas is list
            && (!('isPublic' in data) || data.isPublic is bool)
            && (!('ownerName' in data) || data.ownerName is string)
            && (!('importedFrom' in data) || data.importedFrom is string);
    }
    
    match /editais/{editalId} {
        allow read: if isSignedIn() && (existing().userId == request.auth.uid || existing().isPublic == true);
        
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
        
        allow create: if isSignedIn() 
                      && isValidId(editalId) 
                      && isValidEdital(incoming());
                      
        allow update: if isSignedIn() 
                      && existing().userId == request.auth.uid 
                      && isValidEdital(incoming())
                      && incoming().userId == existing().userId
                      && (incoming().diff(existing()).affectedKeys().hasOnly(['titulo', 'areas', 'isPublic', 'ownerName', 'importedFrom']) || incoming().diff(existing()).affectedKeys().hasOnly([]));
                      
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    function isValidCiclo(data) {
        return data.keys().hasAll(['userId', 'editalId', 'nome', 'items', 'created_at'])
            && data.keys().size() <= 10
            && data.userId is string
            && data.userId == request.auth.uid
            && data.editalId is string
            && data.nome is string
            && data.items is list
            && data.created_at is string
            && (!data.keys().hasAny(['targetMinutes']) || data.targetMinutes is number)
            && (!data.keys().hasAny(['ordem']) || data.ordem is number)
            && (!data.keys().hasAny(['isPublic']) || data.isPublic is bool)
            && (!data.keys().hasAny(['ownerName']) || data.ownerName is string);
    }

    match /ciclos/{cicloId} {
        allow read: if isSignedIn() && (existing().userId == request.auth.uid || existing().isPublic == true);
        
        allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
        
        allow create: if isSignedIn() 
                      && isValidId(cicloId) 
                      && isValidCiclo(incoming());
                      
        allow update: if isSignedIn() 
                      && existing().userId == request.auth.uid 
                      && isValidCiclo(incoming())
                      && incoming().userId == existing().userId
                      && (incoming().diff(existing()).affectedKeys().hasOnly(['nome', 'items', 'targetMinutes', 'ordem', 'isPublic', 'ownerName']) || incoming().diff(existing()).affectedKeys().hasOnly([]));
                      
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
