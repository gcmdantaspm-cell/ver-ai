{
  "entities": {
    "Edital": {
      "title": "Edital",
      "description": "Represents a syllabus/edital imported into the application.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this edital."
        },
        "titulo": {
          "type": "string"
        },
        "areas": {
          "type": "array",
          "description": "Areas array. Given its size, this will be stored as an array to minimize reads, or as JSON. Storing the whole edital as a JSON tree is acceptable since it's generally < 1MB and requested wholesale."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Optional flag to indicate if this edital is publicly viewable/shareable."
        },
        "originalEditalId": {
          "type": "string"
        },
        "importedFrom": {
          "type": "string"
        },
        "managedBy": {
          "type": "string"
        },
        "copiedByEmail": {
          "type": "string"
        },
        "copiedByName": {
          "type": "string"
        },
        "ownerName": {
          "type": "string"
        }
      },
      "required": ["userId", "titulo", "areas"]
    },
    "Ciclo": {
      "title": "Ciclo",
      "description": "Represents a study cycle for an edital.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "editalId": { "type": "string" },
        "nome": { "type": "string" },
        "items": { "type": "array" },
        "created_at": { "type": "string" },
        "targetMinutes": { "type": "number" },
        "ordem": { "type": "number" },
        "isPublic": { "type": "boolean" },
        "ownerName": { "type": "string" },
        "managedBy": { "type": "string" },
        "copiedByEmail": { "type": "string" },
        "copiedByName": { "type": "string" },
        "originalCycleId": { "type": "string" }
      },
      "required": ["userId", "editalId", "nome", "items", "created_at"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User application settings.",
      "type": "object",
      "properties": {
        "pinnedEditalId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/editais/{editalId}": {
      "schema": { "$ref": "#/entities/Edital" },
      "description": "Stores edital documents containing the structured view."
    },
    "/ciclos/{cicloId}": {
      "schema": { "$ref": "#/entities/Ciclo" },
      "description": "Stores study cycles."
    },
    "/users/{userId}/settings/main": {
      "schema": { "$ref": "#/entities/UserSettings" },
      "description": "Stores user settings like pinned edital."
    }
  }
}
